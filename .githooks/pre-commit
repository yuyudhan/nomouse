#!/usr/bin/env bash
# Enable with: just install-hooks (sets core.hooksPath to .githooks).
# Fast checks on the staged tree only (not the working tree): formatting, TOML, guards, spelling,
# shell scripts and host clippy. The pre-push hook runs the full `just verify`.
set -euo pipefail
exec scripts/hooks/in-snapshot.sh pre-commit --index -- just pre-commit
